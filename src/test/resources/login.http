@baseUrl = http://localhost:8080

### 1. 获取验证码
GET {{baseUrl}}/captcha

> {%
    client.global.set("captchaId", response.headers.valueOf("id"));
%}

### 2. 账号密码登录 (执行此请求后会自动保存token)
POST {{baseUrl}}/login/username
Content-Type: application/json

{
  "username": "admin",
  "password": "123456",
  "code": "9335",
  "codeId": "{{captchaId}}",
  "remember": true
}

> {%
    if (response.body && response.body.code === 200) {
        var token = response.body.data && response.body.data.token
            ? response.body.data.token
            : response.body.token;
        if (token) {
            client.global.set("token", token);
        }
    }
%}

### 3. 账号密码登录 - 不记住密码
POST {{baseUrl}}/login/username
Content-Type: application/json

{
  "username": "testuser",
  "password": "password123",
  "code": "6789",
  "codeId": "{{captchaId}}",
  "remember": false
}

> {%
    if (response.body && response.body.code === 200) {
        var token = response.body.data && response.body.data.token
            ? response.body.data.token
            : response.body.token;
        if (token) {
            client.global.set("token", token);
        }
    }
%}

@baseUrl = http://localhost:8080

###############################################
# LoginController 相关接口
###############################################

### 1. 获取验证码
GET {{baseUrl}}/captcha

> {%
    client.global.set("captchaId", response.headers.valueOf("id"));
%}

### 2. 账号密码登录 (执行此请求后会自动保存token)
POST {{baseUrl}}/login/username
Content-Type: application/json

{
  "username": "admin",
  "password": "123456",
  "code": "3792",
  "codeId": "{{captchaId}}",
  "remember": true
}

> {%
    if (response.body && response.body.code === 200) {
        var token = response.body.data && response.body.data.token
            ? response.body.data.token
            : response.body.token;
        if (token) {
            client.global.set("token", token);
        }
    }
%}

### 3. 账号密码登录 - 不记住密码
POST {{baseUrl}}/login/username
Content-Type: application/json

{
  "username": "testuser",
  "password": "password123",
  "code": "6789",
  "codeId": "{{captchaId}}",
  "remember": false
}

> {%
    if (response.body && response.body.code === 200) {
        var token = response.body.data && response.body.data.token
            ? response.body.data.token
            : response.body.token;
        if (token) {
            client.global.set("token", token);
        }
    }
%}

###############################################
# UserController 相关接口 (需要认证)
###############################################

### 用户分页查询
GET {{baseUrl}}/user/page?page=0&size=10
Authorization: Bearer {{token}}
Accept: application/json

### 用户分页查询 - 带状态筛选
GET {{baseUrl}}/user/page?page=0&size=10&search_AND_EQ_status=Y
Authorization: Bearer {{token}}
Accept: application/json

### 根据ID查询用户详情
GET {{baseUrl}}/user/findById/6926a1958f79b1d48e11a6f2
Authorization: Bearer {{token}}
Accept: application/json

### 保存新用户
POST {{baseUrl}}/user/save
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "test",
  "password": "123456",
  "avatarUrl": null,
  "status": "Y"
}

### 更新用户信息
POST {{baseUrl}}/user/save
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id": "6926a1958f79b1d48e11a6f2",
  "username": "admin",
  "avatarUrl": null,
  "status": "Y"
}

### 删除用户
DELETE {{baseUrl}}/user/delete
Authorization: Bearer {{token}}
Content-Type: application/json

["6927ad2bfef9933cb2462c23"]

### 刷新Token
GET {{baseUrl}}/user/refresh
Authorization: Bearer {{token}}
Accept: application/json

> {%
    // 刷新后更新token
    if (response.body && response.body.code === 200) {
        var token = response.body.data && response.body.data.token
            ? response.body.data.token
            : response.body.token;
        if (token) {
            client.global.set("token", token);
        }
    }
%}

### 用户登出
DELETE {{baseUrl}}/user/logout
Authorization: Bearer {{token}}

### 查询用户角色列表
GET {{baseUrl}}/user/getRoleByUserId/6927acb3fef9933cb2462c22
Authorization: Bearer {{token}}
Accept: application/json

### 为用户赋予角色
POST {{baseUrl}}/user/giveRole/6927acb3fef9933cb2462c22
Authorization: Bearer {{token}}
Content-Type: application/json

["6926c5bb8f79996afe1104cc"]


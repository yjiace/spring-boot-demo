@baseUrl = http://localhost:8080

###############################################
# LoginController 相关接口
###############################################

### 1. 获取验证码
GET {{baseUrl}}/captcha

> {%
    client.global.set("captchaId", response.headers.valueOf("id"));
%}

### 2. 账号密码登录 (执行此请求后会自动保存token)
POST {{baseUrl}}/login/username
Content-Type: application/json

{
  "username": "admin",
  "password": "123456",
  "code": "7772",
  "codeId": "{{captchaId}}",
  "remember": true
}

> {%
    if (response.body && response.body.code === 200) {
        var token = response.body.data && response.body.data.token 
            ? response.body.data.token 
            : response.body.token;
        if (token) {
            client.global.set("token", token);
        }
    }
%}

### 3. 账号密码登录 - 不记住密码
POST {{baseUrl}}/login/username
Content-Type: application/json

{
  "username": "testuser",
  "password": "password123",
  "code": "6789",
  "codeId": "{{captchaId}}",
  "remember": false
}

> {%
    if (response.body && response.body.code === 200) {
        var token = response.body.data && response.body.data.token 
            ? response.body.data.token 
            : response.body.token;
        if (token) {
            client.global.set("token", token);
        }
    }
%}

###############################################
# UserController 相关接口 (需要认证)
###############################################

### 用户分页查询
GET {{baseUrl}}/user/page?page=0&size=10&search_username=admin
Authorization: Bearer {{token}}
Accept: application/json

### 用户分页查询 - 带状态筛选
GET {{baseUrl}}/user/page?page=0&size=10&search_status=Y
Authorization: Bearer {{token}}
Accept: application/json

### 根据ID查询用户详情
GET {{baseUrl}}/user/findById/1
Authorization: Bearer {{token}}
Accept: application/json

### 保存新用户
POST {{baseUrl}}/user/save
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "testuser",
  "password": "123456",
  "avatarUrl": "https://example.com/avatar.jpg",
  "status": "Y"
}

### 更新用户信息
POST {{baseUrl}}/user/save
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id": "1",
  "username": "admin",
  "password": "newpassword",
  "avatarUrl": "https://example.com/new-avatar.jpg",
  "status": "Y"
}

### 删除用户
DELETE {{baseUrl}}/user/delete
Authorization: Bearer {{token}}
Content-Type: application/json

["user-id-1", "user-id-2"]

### 刷新Token
GET {{baseUrl}}/user/refresh
Authorization: Bearer {{token}}
Accept: application/json

> {%
    // 刷新后更新token
    if (response.body && response.body.code === 200) {
        var token = response.body.data && response.body.data.token 
            ? response.body.data.token 
            : response.body.token;
        if (token) {
            client.global.set("token", token);
        }
    }
%}

### 用户登出
DELETE {{baseUrl}}/user/logout
Authorization: Bearer {{token}}

### 查询用户角色列表
GET {{baseUrl}}/user/getRoleByUserId/1
Authorization: Bearer {{token}}
Accept: application/json

### 为用户赋予角色
POST {{baseUrl}}/user/giveRole/1
Authorization: Bearer {{token}}
Content-Type: application/json

["role-id-1", "role-id-2", "role-id-3"]

